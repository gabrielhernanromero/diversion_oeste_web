# Copiar a .env.local y completar por cliente. Nunca commitear .env.local real.

# Sitio
NEXT_PUBLIC_SITE_URL=https://www.ejemplo-cliente.com.ar

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# NextAuth (panel de administración)
# Generar con: npx auth secret
AUTH_SECRET=

# Google Analytics 4
NEXT_PUBLIC_GA_ID=

# Resend (notificaciones de formulario de contacto)
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=
